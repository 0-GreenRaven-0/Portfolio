<script>
  const scrollPrompt = document.getElementById('scroll-prompt')!;
  const scrollWrapEl = document.querySelector('.parallax-wrap') as HTMLElement;
  const promptTimer = setTimeout(() => {
    scrollPrompt.classList.add('scroll-prompt-visible');
  }, 3000);
  function hidePrompt() {
    clearTimeout(promptTimer);
    scrollPrompt.classList.remove('scroll-prompt-visible');
    scrollWrapEl.removeEventListener('scroll', hidePrompt);
    window.removeEventListener('wheel', hidePrompt);
    window.removeEventListener('touchmove', hidePrompt);
  }
  scrollWrapEl.addEventListener('scroll', hidePrompt, { once: true });
  window.addEventListener('wheel', hidePrompt, { once: true });
  window.addEventListener('touchmove', hidePrompt, { once: true });

  const starsContainer = document.getElementById('stars-container')!;

  function spawnStar() {
    const star = document.createElement('span');
    star.classList.add('shooting-star');
    star.style.top = '0%';
    star.style.left = `${10 + Math.random() * 80}%`;
    const dur = 1.5 + Math.random() * 0.5;
    star.style.animationDuration = `${dur}s`;
    starsContainer.appendChild(star);
    star.addEventListener('animationend', () => star.remove());
    setTimeout(spawnStar, 4000 + Math.random() * 4000);
  }
  setTimeout(spawnStar, 1000);
  setTimeout(spawnStar, 3000);

  const hamburger = document.getElementById('hamburger')!;
  const navLinksWrap = document.getElementById('nav-links')!;

  const backdrop = document.createElement('div');
  backdrop.style.cssText = `
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.55); z-index: 9998;
    transition: opacity 0.3s ease;
    opacity: 0;
  `;
  document.body.appendChild(backdrop);

  function closeMenu() {
    navLinksWrap.classList.add('closing');
    backdrop.style.opacity = '0';
    setTimeout(() => {
      hamburger.classList.remove('open');
      navLinksWrap.classList.remove('open');
      navLinksWrap.classList.remove('closing');
      backdrop.style.display = 'none';
    }, 280);
  }

  backdrop.addEventListener('click', closeMenu);

  hamburger.addEventListener('click', (e) => {
    e.stopPropagation();
    if (navLinksWrap.classList.contains('open')) {
      closeMenu();
    } else {
      if (navLinksWrap.parentElement !== document.body) {
        document.body.appendChild(navLinksWrap);
      }
      backdrop.style.display = 'block';
      requestAnimationFrame(() => { backdrop.style.opacity = '1'; });
      hamburger.classList.add('open');
      navLinksWrap.classList.add('open');
    }
  });

  document.addEventListener('click', (e) => {
    if (navLinksWrap.classList.contains('open') && !navLinksWrap.contains(e.target as Node)) {
      closeMenu();
    }
  });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const scrollWrap = document.querySelector('.parallax-wrap') as HTMLElement;

  function smoothScrollTo(target: number, duration: number = 1000) {
    const start = scrollWrap.scrollTop;
    const distance = target - start;
    let startTime: number | null = null;

    function step(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const ease = progress < 0.5
        ? 4 * progress * progress * progress
        : 1 - Math.pow(-2 * progress + 2, 3) / 2;
      scrollWrap.scrollTop = start + distance * ease;
      if (elapsed < duration) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector(link.getAttribute('href')!);
      if (target) {
        smoothScrollTo((target as HTMLElement).offsetTop, 1200);
      }
      closeMenu();
    });
  });

  type ListItem = { name: string; href: string };

  const listData: Record<string, ListItem[]> = {
    'creative-strategies': [{ name: 'Will be added soon...', href: '#' }],
    'funnel-strategies': [
      { name: 'Droparabia Landing Page',                  href: 'https://join.droparabia.com/start' },
      { name: 'Bianca Closer Academy',                    href: 'https://bianca-closer-academy.pages.dev/' },
      { name: 'ENE Lead Magnet',                          href: 'https://ene-lead-magnet.pages.dev' },
      { name: 'Droparabia Sales Page',                    href: 'https://join.droparabia.com' },
      { name: 'Droparabia Instagram Funnel Sales Page',   href: 'https://book.droparabia.com' },
      { name: 'Samara Michael Workshop',                  href: 'https://0-greenraven-0.github.io/SamaraMichaelsFBA/' },
      { name: 'Droparabia Webinar Registration Page',     href: 'https://workshop.droparabia.com' },
    ],
    'email-marketing': [
      { name: 'Droparabia - Welcome', href: 'https://docs.google.com/document/d/1SbbBALudSa7dw6sym-iuWTz33QFeccrTZZtEcD3ZUH8/edit?usp=sharing' },
      { name: 'Droparabia - Email 1', href: 'https://docs.google.com/document/d/1Vn3x7Le2cEDn7n33pQ19hG02f17rcrIMoYZhOlj3WmA/edit?usp=sharing' },
      { name: 'Droparabia - Email 2', href: 'https://docs.google.com/document/d/1PPmN-Rt9BZEkOKTDG8tlPtJUHlslZ0qqkllB6S7jpi0/edit?usp=sharing' },
      { name: 'Droparabia - Email 3', href: 'https://docs.google.com/document/d/1E77DT3RQiUelPREDPubJmpS7f9h2Sl4JdiKvsp0WQKg/edit?usp=sharing' },
      { name: 'RSI - Email 1',        href: 'https://docs.google.com/document/d/1Rw0mG7uk4WB_WxtyNNC3uAEbj6hLlQLCAbSeaCp29qo/edit?usp=sharing' },
      { name: 'RSI - Email 2',        href: 'https://docs.google.com/document/d/1hvH7EddiJnf5OAC5lotbTYa0DZG9VKDW-qgpxRu64Y4/edit?usp=sharing' },
    ],
    'instagram-content': [{ name: 'Will be added soon...', href: '#' }],
  };

  const titles: Record<string, string> = {
    'creative-strategies': 'Creative Strategies',
    'funnel-strategies':   'Funnel Strategies',
    'email-marketing':     'Email Marketing',
    'instagram-content':   'Content Creation',
  };

  const overlay = document.getElementById('portfolio-overlay')!;
  const portfolioHeading = document.getElementById('portfolio-heading')!;
  const overlayTitle = document.getElementById('portfolio-overlay-title')!;
  const projectList = document.getElementById('portfolio-project-list')!;
  const backBtn = document.getElementById('portfolio-back')!;
  const portfolioGrid = document.querySelector('.portfolio-grid') as HTMLElement;

  function renderList(items: ListItem[]) {
    items.forEach(p => {
      const li = document.createElement('li');
      const a = p.href === '#' ? document.createElement('span') : document.createElement('a');
      if (a instanceof HTMLAnchorElement) a.href = p.href;
      a.textContent = p.name;
      a.classList.add('portfolio-project-item');
      if (p.href === '#') a.classList.add('portfolio-project-coming-soon');
      a.style.opacity = '0';
      a.style.transform = 'translateY(8px)';
      li.appendChild(a);
      projectList.appendChild(li);
    });
  }

  function handleBackToGrid() {
    const items = projectList.querySelectorAll<HTMLElement>('.portfolio-project-item');
    items.forEach(item => { item.style.opacity = '0'; item.style.transform = 'translateY(8px)'; });
    setTimeout(() => {
      overlay.style.display = 'none';
      portfolioHeading.style.visibility = '';
      portfolioGrid.style.visibility = '';
      const gridCards = portfolioGrid.querySelectorAll<HTMLElement>('.portfolio-card');
      gridCards.forEach(c => { c.style.opacity = '0'; c.style.transform = 'translateY(8px)'; });
      requestAnimationFrame(() => {
        gridCards.forEach((c, i) => {
          setTimeout(() => { c.style.opacity = '1'; c.style.transform = 'translateY(0)'; }, i * 50);
        });
      });
    }, 250);
  }

  backBtn.onclick = handleBackToGrid;

  document.querySelectorAll<HTMLButtonElement>('.portfolio-card').forEach(card => {
    card.addEventListener('click', () => {
      const category = card.dataset.category!;
      overlayTitle.textContent = titles[category] ?? category;
      projectList.innerHTML = '';
      projectList.className = 'portfolio-project-list';
      if (listData[category]) renderList(listData[category]);

      const gridCards = portfolioGrid.querySelectorAll<HTMLElement>('.portfolio-card');
      gridCards.forEach(c => { c.style.opacity = '0'; c.style.transform = 'translateY(8px)'; });
      setTimeout(() => {
        portfolioGrid.style.visibility = 'hidden';
        portfolioHeading.style.visibility = 'hidden';
        overlay.style.display = 'flex';
        const items = projectList.querySelectorAll<HTMLElement>('.portfolio-project-item');
        requestAnimationFrame(() => {
          items.forEach((item, i) => {
            setTimeout(() => { item.style.opacity = '1'; item.style.transform = 'translateY(0)'; }, i * 80);
          });
        });
      }, 250);
    });
  });
</script>




</BaseLayout>
